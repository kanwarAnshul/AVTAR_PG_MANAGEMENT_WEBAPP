{
  "expo": {
    "name": "AVTAR SINGH PG",
    "slug": "avtar-pg-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10130D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avtarsingh.pgmanager",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Required to upload tenant photos and complaint images",
        "NSPhotoLibraryUsageDescription": "Required to upload documents and photos",
        "NSMicrophoneUsageDescription": "Not used"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10130D"
      },
      "package": "com.avtarsingh.pgmanager",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F5E28",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AVTAR PG to access your photos for document uploads.",
          "cameraPermission": "Allow AVTAR PG to use your camera for document photos."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite"
    ],
    "scheme": "avtarpg",
    "extra": {
      "eas": {
        "projectId": "6977cd50-5983-4973-9541-3201a713128f"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "arpit_kanwar_27"
  }
}
